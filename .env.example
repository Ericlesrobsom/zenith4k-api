# URL base do painel (sem o caminho da franquia tambem funciona)
ZENITH_URL=https://aplicativo.znt4kh.uk
# Credenciais da franquia (revenda). NUNCA commite o .env.
ZENITH_USER=zenith4k
ZENITH_PASS=
# Opcional: franquia raiz quando o login e de uma sub-revenda
ZENITH_FRANQUIA=
# cliente | admin
ZENITH_ROLE=cliente
# Token local exigido pelo servidor REST (qualquer string longa aleatoria)
ZENITH_API_TOKEN=
# Bind do servidor local
ZENITH_BIND=127.0.0.1:8787
